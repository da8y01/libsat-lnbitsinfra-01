# =============================================================
# .env — Variables sensibles del proyecto lnbits-infrastructure
# =============================================================
# Cambie los valores por defecto antes de usar en producción o mainnet.

# --- SSH (contenedor base) ---
SSH_PASSWORD=sshpassword

# --- Bitcoin Core RPC ---
BITCOIN_RPC_USER=rpcuser
BITCOIN_RPC_PASSWORD=rpcpassword

# --- Tor ControlPort ---
TOR_PASSWORD=torpassword
TOR_HASHED_CONTROL_PASSWORD=12:ABCD

# --- LND ---
LND_ALIAS=LndAlias
# Semilla cipher de 24 palabras (guárdela en un lugar seguro fuera de este repositorio)
LND_CIPHER_SEED=

# --- Red Docker ---
DOCKER_SUBNET=172.28.0.0/16

# --- FASE 5: Clientes web (RTL y satoshi-odyssey) ---
RTL_PORT=3000
# Password de acceso a la UI de RTL (evitar: password, changeme, moneyprintergobrrr)
RTL_MULTIPASS=rtlmypassword
SATODYSSEY_PORT=9630
SATODYSSEY_USER=admin
SATODYSSEY_PASS=mysatoshipassword
